PORT=3210
DATA_DIR=storage
LOG_LEVEL=info

# Mode TikTok: demo (event palsu, untuk uji) atau live (konek ke room sungguhan)
TIKTOK_MODE=demo
TIKTOK_USERNAME=demo

# Nama device audio tujuan (kosong = device default Windows).
# Setelah VB-Cable terpasang biasanya: CABLE Input (VB-Audio Virtual Cable)
AUDIO_DEVICE=
